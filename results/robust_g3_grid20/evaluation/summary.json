    "primary_gap": "certainty-equivalent loss, 252 * (U_best - U) in basis points per year",
    "relative_gap": "(U_best - U) / |U_best|; None when |U_best| < 1e-5 per day",
    "evaluation_sample": "10000 episodes x 20 days from SeedPlan's evaluation stream; exact values are primary, realized values a check",
    "mean_of_seed_weights": "average of the seeds' weights; not a portfolio any seed holds, so never compared with the benchmarks",
    "regret_units": "daily objective units summed over episodes; divide by the episode count and multiply by 252 * 1e4 for the average loss per episode in bps/yr",
    "total_gap": "ce_loss_vs_continuous_bps: discretization gap plus learning gap, per seed",
    "median_seed": "the weights chart's median seed is the upper median (6th of 10 by learning gap); summary medians average the two middle seeds",
    "observations": "simulated days = episodes x B; greedy_stable_through_end includes its K-episode waiting window",
    "q_fit": "final Q-values vs the true expected reward U(w) of every portfolio (all) or of those the agent tried (visited); top-10 recall is the share of the true top 10 in the learned top 10; optimism is 252 * (Qhat - U) of the learned portfolio in bps/yr. Evaluation only"
  }
